# Copy this file to .env in the repo root and fill in only what you use.
# The app loads .env automatically at startup (API, CLI, and demo).
# A variable set in the real environment always takes precedence over .env.
#
# THE STANDARD RUN IS THE REAL ZEP CLOUD PROFILE — that is the
# deployment this blueprint exists to prove: set CONTEXT_BACKEND=zep
# and add your Zep API key below. The offline adapter is the labelled
# fallback for tests, evals, and no-key smoke runs; it implements the
# same ContextPort semantics over a local temporal graph.

# Which context backend to use: zep | offline
CONTEXT_BACKEND=zep

# ---------------------------------------------------------------------------
# Zep Cloud (CONTEXT_BACKEND=zep)
# ---------------------------------------------------------------------------
# API key from the Zep dashboard (app.getzep.com → Settings → API Keys).
ZEP_API_KEY=
# Base URL of the Zep Cloud API. Override for a self-hosted / BYOC
# deployment of the Zep stack.
ZEP_API_BASE_URL=https://api.getzep.com/api/v2
# Per-request timeout (seconds) for Zep calls.
# ZEP_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Optional narrative model (the brief's facts are assembled in code;
# a model may only narrate them — see docs/architecture.md). Any
# OpenAI-compatible endpoint works via OPENAI_BASE_URL, including a
# self-hosted NVIDIA NIM container (http://localhost:8000/v1) or the
# hosted catalog (https://integrate.api.nvidia.com/v1).
# Without a key, the brief carries a deterministic template narrative,
# labelled as such.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=<redacted>
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Production data services (set by docker-compose; unset = the
# in-memory test doubles, and /readiness says so)
# ---------------------------------------------------------------------------
# DATABASE_URL=<redacted>
# REDIS_URL (optional): the brief/retrieval cache + ingestion
# coordination lock. Redis is an accelerator, never a source of
# truth — unset means caching is disabled and /readiness says so.
# REDIS_URL=redis://redis:6379/0
# S3_ENDPOINT_URL=http://minio:8333
# S3_BUCKET=underwriting-context-documents
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
